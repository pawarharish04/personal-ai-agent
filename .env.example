# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth Configuration (Desktop Application Client)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback

# Web Search Option 1: Exa (Recommended: 1,000 free searches, neural search for AI agents)
# Get a free key at: https://dashboard.exa.ai
EXA_API_KEY=your_exa_api_key_here

# Web Search Option 2: Tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Web Search Option 3: Google Custom Search
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here

